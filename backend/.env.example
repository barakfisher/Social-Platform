ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://social_app:social_app_local@localhost:55473/social
MIGRATION_DATABASE_URL=postgresql+psycopg://social_admin:social_admin_local@localhost:55473/social
REDIS_URL=redis://localhost:56373/0
# Pages that may call and write to the API: only this app's Next server (SP-23).
CORS_ORIGINS=["http://localhost:53073","http://127.0.0.1:53073"]
# Host header values the API answers (without port); others get 400 (DNS rebinding).
ALLOWED_HOSTS=["127.0.0.1","localhost"]
# OpenRouter embedding integration. Keep the key private; never put it in frontend variables.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_REVISION=1
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=20

# Generation uses EMBEDDING_API_KEY only when both providers use official OpenRouter.
# Set this separately to use a different key/provider. Secrets stay on the backend.
GENERATION_API_KEY=
GENERATION_BASE_URL=https://openrouter.ai/api/v1
GENERATION_MODEL=openai/gpt-4.1
# Writers users may choose; each needs a measured profile in app/writer_models.py.
GENERATION_WRITER_MODELS=["openai/gpt-4.1","google/gemini-3.8-flash","anthropic/claude-opus-5.5","openai/gpt-5.6-sol"]
GENERATION_REVIEW_MODEL=openai/gpt-5.6-terra
GENERATION_REVIEW_MODELS=["openai/gpt-5.6-terra","openai/gpt-4.1"]
GENERATION_TOKENIZER=o200k_base
GENERATION_TIMEOUT=40
GENERATION_RETRIES=1
GENERATION_MAX_OUTPUT_TOKENS=900
GENERATION_REVIEW_MAX_OUTPUT_TOKENS=5000
GENERATION_PROMPT_BUDGET=30000
GENERATION_CONTEXT_BUDGET=24000
GENERATION_MAX_DISTANCE=0.65
GENERATION_MAX_REQUEST_USD=0.80
# Private uploaded source files (SP-9); docker-compose mounts a volume here.
SOURCE_STORAGE_DIR=var/sources
UPLOAD_MAX_BYTES=10485760
PDF_MAX_PAGES=300
SOURCE_MAX_CHARACTERS=200000
